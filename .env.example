# No training data or original model is required. Copy to .env to customise.
MODEL_NAME=openai-community/gpt2
TRANSLATOR_PT_EN=Helsinki-NLP/opus-mt-ROMANCE-en
TRANSLATOR_EN_PT=Helsinki-NLP/opus-mt-tc-big-en-pt
PORTUGUESE_PREFIX=">>por<< "
DEVICE=cpu
MAX_NEW_TOKENS=80
TEMPERATURE=0.85
CONTEXT_TOKENS=384
# Use 1 only after downloading the required model/tokenizer files.
LOCAL_FILES_ONLY=0
